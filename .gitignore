*.py[cod]
*$py.class
.venv/
venv/
env/
.ipynb_checkpoints/
*.egg-info/
dist/
build/

# ==========================================
# 2. Frontend / Node / Build Tools
# ==========================================
node_modules/
.vite/
.next/
out/
dist-web/
npm-debug.log*
yarn-debug.log*
