# ==========================================
# 4. Raw Geospatial Rasters & Heavy Data
# (Keep processed GeoJSONs for the web app, ignore massive raw downloads)
# ==========================================
data/raw/
*.tif
*.tiff
*.geotiff
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.gpkg
*.zip

# ==========================================
# 5. Uncompressed Studio Audio & DAW Files
# (Commit final web-ready .mp3/.ogg, ignore raw .wav/project files)
# ==========================================
audio/raw/
*.wav
*.aiff
*.flac
*.aup3
*.als
*.logicx

# ==========================================
# 6. OS & Editor Files
# ==========================================
.DS_Store
Thumbs.db
.vscode/
.idea/